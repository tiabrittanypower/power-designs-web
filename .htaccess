# Power Designs Web — Hostinger (Apache / LiteSpeed)
# Generated for: https://powerdesign.co.za
# Upload this file to public_html (site root) with the rest of the site.

DirectoryIndex index.html

# --- HTTPS (enable after SSL is active in hPanel) ---
# <IfModule mod_rewrite.c>
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Prefer clean home URL
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Block accidental exposure of operator paths if ever uploaded
<IfModule mod_rewrite.c>
  RewriteRule ^(launch-dashboard|tools|blog-workspace|social-content-creator|scripts|docs|brand-kit|node_modules|\.git)(/|$) - [F,L]
</IfModule>

# Security headers (LiteSpeed / Apache mod_headers)
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set X-XSS-Protection "0"
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net; connect-src 'self' https: https://formsubmit.co https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://*.facebook.com https://*.facebook.net; frame-src 'self' https://www.facebook.com https://connect.facebook.net; frame-ancestors 'self'; base-uri 'self'; form-action 'self' mailto: https://wa.me https://formsubmit.co https://calendar.app.google https://calendar.google.com"
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(sitemap.*\.xml|sitemap\.txt|robots\.txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Correct MIME for sitemaps
AddType application/xml .xml
AddType text/plain .txt

# Compress text where supported
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Branded 404
ErrorDocument 404 /404.html
